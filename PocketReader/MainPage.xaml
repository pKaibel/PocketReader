<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PocketReader.MainPage"
             xmlns:viewmodels="clr-namespace:SwiftLernApp.ViewModels"
             xmlns:models="clr-namespace:SwiftLernApp.Models" 
             x:DataType="viewmodels:BookmarkViewModel" 
             Title="Pocket Reader by PhilKa"
             IconImageSource="swift_logo.png" >

    <!-- Binding to the ViewModel -->
    <ContentPage.BindingContext>
        <viewmodels:TopicViewModel />
    </ContentPage.BindingContext>

    <!-- This is the main page of the Swift Lern App. It displays a welcome message, a logo, and a list of topics for learning Swift. -->
    <ListView   
        Margin="20"  
        x:Name="TopicListView"
        ItemsSource="{Binding Topics}"
        ItemSelected="OnItemSelected">

        <!-- Header of the ListView with a welcome message and logo -->
        <ListView.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#2f5cb6"/>
                <Border Grid.Column ="1" Background="#1f3d7a"/>
                <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#152951"/>
                <Image   
                    Grid.Row="0" Grid.Column="0"  
                    Source="swift_logo.png"  
                    WidthRequest="100" 
                    HeightRequest="100"
                    Aspect="AspectFit"
                    Margin="15"/>
                <controls:StackLayout Grid.Column="1" Margin="20,0,0,0" VerticalOptions="Center">
                    <Label Text="Welcome," TextColor="White" FontSize="Large"/>
                    <Label Text="this App helps you" TextColor="White" FontSize="Large"/>
                    <Label Text="to learn Swift" TextColor="White" FontSize="Large"/>
                </controls:StackLayout>
                <controls:StackLayout Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"    
                    HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="Select a topic to learn more:"   
                        TextColor="White" FontSize="Medium" Margin="0,0,20,0"/>
                </controls:StackLayout>
            </Grid>
        </ListView.Header>

        <!-- ItemTemplate for the ListView to display each topic -->
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="models:Topic">
                <TextCell Text="{Binding Title}" />
            </DataTemplate>
        </ListView.ItemTemplate>

    </ListView>

</ContentPage>
